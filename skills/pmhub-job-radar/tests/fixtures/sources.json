{
  "schema_version": "1",
  "defaults": {
    "fresh_days": 7,
    "stale_days": 30,
    "close_after_misses": 2,
    "request_interval_seconds": 0.2,
    "timeout_seconds": 5,
    "max_response_bytes": 1048576,
    "max_retries": 0
