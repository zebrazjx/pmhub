    {"id": "acme-ashby", "provider": "ashby", "company": "Acme", "board": "Acme"},
    {"id": "acme-sr", "provider": "smartrecruiters", "company": "Acme", "company_identifier": "acme", "max_results": 100},
    {"id": "acme-site", "provider": "jsonld", "company": "Acme", "urls": ["https://careers.acme.example/jobs/site-pm-1"]},
    {"id": "official-search", "provider": "google_cse", "query": "AI product manager jobs", "site_search": "careers.acme.example", "api_key_env": "PMHUB_GOOGLE_CSE_KEY", "cx_env": "PMHUB_GOOGLE_CSE_CX", "max_results": 10},
    {"id": "authorized-export", "provider": "manual_import", "path": "manual.jsonl", "format": "jsonl"}
